package task6;

import java.io.File;

import studiplayer.basic.BasicPlayer;

public abstract class  SampledFile extends AudioFile {
	
	public long duration;
	public SampledFile() {
		super();
	}
//constructor which checks if the file is readable and if yes then it continues with the program
	public SampledFile(String pathname) throws RuntimeException {
		super(pathname);
		File file = new File(getPathname());
		if(!file.canRead()) {
			throw new RuntimeException("File cannot be read, path might be wrong");
		}
	}

//plays the audio
	public void play() throws RuntimeException {
			BasicPlayer.play(getPathname());
	}

//pauses the audio
	public void togglePause() {
		BasicPlayer.togglePause();

	}

//stops the audio
	public void stop() {
		BasicPlayer.stop();

	}

//formats the total duration of the song
	public String formatDuration() {
		return timeFormatter(getDuration());
	}

//formats the position of the song
	public String formatPosition() {
		return timeFormatter(BasicPlayer.getPosition());
	}
//formats the time in this form --> mm:ss
	public static String timeFormatter(long timeInMicroSeconds) {
			
			 long seconds = timeInMicroSeconds/ 1000000;
			 long minutes = seconds / 60;
		     long remainingSeconds = seconds % 60;
		    //this is not needed as %02d does this for us
		     /* 
		     if(minutes < 10 && minutes > 0) {
		    	 finalMinutes = "0" + minutes;
		     }else {
		    	 finalMinutes = "" + minutes;
		     }
		     if(remainingSeconds < 10 && remainingSeconds > 0) {
		    	 finalSeconds = "0" + remainingSeconds;
		     }else {
		    	 finalSeconds = "" + remainingSeconds;
		     }*/
		     
		    
		     return String.format("%02d:%02d", minutes, remainingSeconds);
	}
//getter for the duration
	public long getDuration() {
		return duration;
	}

}
