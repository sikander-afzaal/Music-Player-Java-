
public class AudioFileFactory {

	public AudioFileFactory(String path) {
		createAudioFile(path);
	}
	public static AudioFile createAudioFile(String path) throws RuntimeException {
		String fileExtension = path.substring(path.lastIndexOf('.') + 1, path.length()).toLowerCase();
		switch (fileExtension) {
		case "mp3":
			return new TaggedFile(path);
		case "ogg":
			return new TaggedFile(path);
		case "wav":
			return new WavFile(path);
		default:
			throw new RuntimeException("File type not supported");
		}
		
	}
}
