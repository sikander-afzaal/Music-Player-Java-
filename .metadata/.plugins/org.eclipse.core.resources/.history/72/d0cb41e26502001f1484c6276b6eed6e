package studioplayer.audio;

public class NotPlayableException extends Exception {
	private static final long serialVersionUID = -6212327537213302405L;
	String pathname;
	
	public NotPlayableException(String pathname, String msg) {
		super(msg);
		this.pathname = pathname;
	}
	
	public NotPlayableException(String pathname, Throwable t) {
		super(t);
		this.pathname = pathname;
	}
	
	public NotPlayableException(String pathname, String msg, Throwable t) {
		super(msg, t);
		this.pathname = pathname;
	}
	public String toString() {
	    StringBuilder sb = new StringBuilder();
	    sb.append(pathname).append(": ").append(super.toString());
	    
	    // If there's a cause, append its message as well
	    if (getCause() != null) {
	        sb.append("\nRoot-Cause: ").append(getCause().toString());
	    }
	    
	    return sb.toString();
	}
}
