package task6;

import studiplayer.basic.WavParamReader;
import java.util.concurrent.TimeUnit;


public class WavFile extends SampledFile {
	public WavFile() {
		super();
	}

	public WavFile(String pathname) {
		super(pathname);
		readAndSetDurationFromFile();
	}
	public void readAndSetDurationFromFile() {
		WavParamReader.readParams(getPathname());
	float frameRate =	WavParamReader.getFrameRate();
	long numberOfFrames = WavParamReader.getNumberOfFrames();
	this.duration =  computeDuration(numberOfFrames,frameRate);
	
	}
	public String toString() {return null;}
	public static long computeDuration(long numberOfFrames, float frameRate){
		double result =  (numberOfFrames /  frameRate);
		// Temporary fix doesnt work for all
		return (long) Math.round(result * 1000000) - 2;
	}
}
