package studioplayer.audio;

import java.util.Comparator;

public class DurationComparator implements Comparator<AudioFile> {

	public int compare(AudioFile o1, AudioFile o2) {
		String o1StringRepresentation = o1.toString();
		String o1Duration = o1StringRepresentation.substring(o1StringRepresentation.lastIndexOf("-") + 1,o1StringRepresentation.length()).trim(); 
		int o1Minutes = Integer.parseInt(o1Duration.substring(0,o1Duration.indexOf(":")));
		
		String o2StringRepresentation = o2.toString();
		String o2Duration = o1StringRepresentation.substring(o2StringRepresentation.lastIndexOf("-") + 1,o2StringRepresentation.length()).trim(); 
		int o2Minutes = Integer.parseInt(o2Duration.substring(0,o2Duration.indexOf(":")));
		
		
		if(o1Minutes > o2Minutes) {
			return 1;
		}else if (o1Minutes == o2Minutes ) {
			return 1;
		}else return -1;
		
		
	}

	
}
