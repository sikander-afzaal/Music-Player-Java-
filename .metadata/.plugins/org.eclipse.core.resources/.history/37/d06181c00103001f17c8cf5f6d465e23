package studioplayer.audio;

import java.io.File;
import java.io.FileNotFoundException;
import java.io.FileWriter;
import java.io.IOException;
import java.util.Iterator;
import java.util.LinkedList;
import java.util.List;
import java.util.Scanner;

public class PlayList implements Iterable<AudioFile> {

	private String search;
	private SortCriterion sortCriterion = SortCriterion.DEFAULT;
	LinkedList<AudioFile> audioFiles = new LinkedList<>();
	ControllablePlayListIterator musicPlayer = new ControllablePlayListIterator(audioFiles);

	public PlayList() {

	}

	public PlayList(String m3uPathname) throws NotPlayableException {
		loadFromM3U(m3uPathname);
	}

	public void add(AudioFile file) {
		if (file == null) {
			return;
		} else {
			getList().add(file);
			musicPlayer.setCurrentIdx(-1);
		}
		;

	}

	public void remove(AudioFile file) {
		getList().remove(file);
		musicPlayer.setCurrentIdx(-1);

	}

	public int size() {
		return getList().size();
	}

	public AudioFile currentAudioFile() {
		return musicPlayer.getCurrentAudioFile();
	}

	public void nextSong() {
		musicPlayer.next();
	}

	public void loadFromM3U(String pathname) throws NotPlayableException {
	    Scanner scanner = null;

	    getList().clear();
	    try {
	        // clear the list before loading new music files
	        File file = new File(pathname);
	        if (!file.canRead()) {
	            throw new NotPlayableException(pathname, "File does not exist");
	        }

	        // open the file for reading
	        scanner = new Scanner(file);

	        // while there are lines the while loop runs
	        while (scanner.hasNextLine()) {
	            // stores the next line in this variable
	            String line = scanner.nextLine();
	            // if blank or starts with # skip this iteration
	            if (line.startsWith("#") || line.isBlank()) {
	                continue;
	            } else {
	                try {
	                    this.add(AudioFileFactory.createAudioFile(line));                       
	                } catch (NotPlayableException e) {
	                    // Skip non-existing files silently
	                    continue;
	                }
	            }
	        }

	    } catch (FileNotFoundException e) {
	        throw new NotPlayableException(pathname, "File Not Found");
	    } finally {
	        try {
	            if (scanner != null)
	                scanner.close();
	        } catch (Exception e) {
	            // ignore; probably because file could not be opened
	        }
	    }
	}


	public void saveAsM3U(String pathname) {
		FileWriter writer = null;
		String sep = System.getProperty("line.separator");
		try {
			// create the file if it does not exist, otherwise reset the file
			// and open it for writing
			writer = new FileWriter(pathname);
			for (AudioFile file : getList()) {
				// write the current line + newline char
				writer.write(file.getPathname() + sep);
			}
		} catch (IOException e) {
			throw new RuntimeException("Unable to write file " + pathname + "!");
		} finally {
			try {
				System.out.println("File " + pathname + " written!");
				// close the file writing back all buffers
				writer.close();
			} catch (Exception e) {
				// ignore exception; probably because file could not be opened
			}
		}

	}

	public List<AudioFile> getList() {
		return audioFiles;
	}

	// change type of parameter later -------

	public void setSearch(String value) {
		this.search = value;

		musicPlayer.sortAndFilterPlaylist(getList(), value, getSortCriterion());

	}

	public SortCriterion getSortCriterion() {
		return sortCriterion;
	}

	public void setSortCriterion(SortCriterion sortCriterion) {
		this.sortCriterion = sortCriterion;
		musicPlayer.sortAndFilterPlaylist(getList(), getSearch(), sortCriterion);

	}

	public String getSearch() {
		return search;
	}

	public Iterator<AudioFile> iterator() {
		return new ControllablePlayListIterator(getList(), getSearch(), getSortCriterion());
	}

	public AudioFile jumpToAudioFile(AudioFile file) {
		return musicPlayer.jumpToAudioFile(file);
	}
	public String toString() {
		return getList().toString();
	}

}
