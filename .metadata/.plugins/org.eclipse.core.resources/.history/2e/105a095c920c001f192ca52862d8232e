package studiplayer.audio;

import java.util.Iterator;

import java.util.LinkedList;
import java.util.List;



public class ControllablePlayListIterator implements Iterator<AudioFile> {
	protected int currentIdx = 0; // determines the current idx at which we are in the playlist
	protected List<AudioFile> playListSortedAndFiltered = new LinkedList<AudioFile>(); // current playlist
	
	
	public ControllablePlayListIterator(List<AudioFile> playlist) {
		this.playListSortedAndFiltered = playlist;
	}

	public ControllablePlayListIterator(List<AudioFile> playlist, String filter, SortCriterion sorting) {
		this.playListSortedAndFiltered = playlist;
		sortAndFilterPlaylist(playlist, filter, sorting);

	}

	// return true or false if the current idx is less then the playlist length
	public boolean hasNext() {
		return getCurrentIdx() < this.playListSortedAndFiltered.size();
	}

	// returns the next audio file in the list and also increments the current idx
	// for future
	public AudioFile next() {
	    if (this.playListSortedAndFiltered.isEmpty()) {
	        return null;
	    }
	    
	    setCurrentIdx(getCurrentIdx() + 1);

	    if (getCurrentIdx() >= this.playListSortedAndFiltered.size()) {
	        setCurrentIdx(0);
	    }
	    
	    return this.playListSortedAndFiltered.get(getCurrentIdx());
	}
	// setter for the current idx
	public void setCurrentIdx(int currentIdx) {
		this.currentIdx = currentIdx;
	}

	// getter for the current idx
	public int getCurrentIdx() {
		return currentIdx;
	}

	public List<AudioFile> getPlaylist() {
		return playListSortedAndFiltered;
	}

	public AudioFile getCurrentAudioFile() {
	    if (playListSortedAndFiltered.isEmpty()) {
	        return null;
	    }
	    
	    if (getCurrentIdx() >= playListSortedAndFiltered.size() || getCurrentIdx() < 0) {
	        setCurrentIdx(0);
	    }
	    
	    return playListSortedAndFiltered.get(getCurrentIdx());
	}

	public void sortAndFilterPlaylist(List<AudioFile> playlist, String filter, SortCriterion sorting) {
		setCurrentIdx(0);
		List<AudioFile> playListFiltered = new LinkedList<AudioFile>(playlist);
		if (filter == null || filter.isEmpty() || filter.isBlank()) {
			playListFiltered = new LinkedList<AudioFile>(playlist);
		} else {
			playListFiltered = new LinkedList<AudioFile>();
			for (int i = 0; i < playlist.size(); i++) {
				AudioFile currentItemInIteration = playlist.get(i);
				if (currentItemInIteration.getAlbum().contains(filter)
						|| currentItemInIteration.getTitle().contains(filter)
						|| currentItemInIteration.getAuthor().contains(filter)) {
					playListFiltered.add(currentItemInIteration);
				}
			}
		}

		switch (sorting) {
		case TITLE:
			playListFiltered.sort(new TitleComparator());
			break;
		case AUTHOR:
			playListFiltered.sort(new AuthorComparator());
			break;
		case ALBUM:
			playListFiltered.sort(new AlbumComparator());
			break;
		case DURATION:
			playListFiltered.sort(new DurationComparator());
			break;
		default:
			
			break;
		}

		playListSortedAndFiltered = playListFiltered;

	}

	// this function jumps to the specified audio file and also increments the
	// current idx so the next function in the future calls the next song
	public AudioFile jumpToAudioFile(AudioFile file) {
		int musicToJumpToIdx = this.playListSortedAndFiltered.indexOf(file); // finding the index of the audiofile
		
	    if (musicToJumpToIdx != -1) {
	        setCurrentIdx(musicToJumpToIdx); // Set the current index directly
	        
	        return this.playListSortedAndFiltered.get(musicToJumpToIdx);
	    } else {
	        return null; // No song found
	    }
	}
}
