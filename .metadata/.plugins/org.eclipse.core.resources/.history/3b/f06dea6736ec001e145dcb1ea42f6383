	*/
	public String getPathName() {
		return this.pathname;
	}
	public String getFileName() {
		return this.filename;
	}
	public void parsePathNames(String path) {
		String newPath = path;
		//correcting the pathname
		for (int i = 0; i < path.length(); i++){
			int nextIndex = i + 1;
			int slashIndexes = 1;
		    if(newPath.substring(i,nextIndex).contains("/")) {
		    	int temp = nextIndex + 1;
		    	if((newPath.substring(nextIndex,temp).contains("/"))) {
		    	while (newPath.substring(nextIndex,temp).contains("/")) {
		    		slashIndexes++;
		    		temp++;
		    		nextIndex++;
		    	}
		    	String slashesReplaced = newPath.substring(i,i + slashIndexes );
		    	newPath = path.replace(slashesReplaced,"/")
		    	;
		    	}
		    	
		    }
		}
		
		System.out.println(newPath);
		
		
		//getting filename
		int lastSlashIndex = path.lastIndexOf("/") + 1; //to get the filename start index
		if(lastSlashIndex != -1) {		
			this.filename = path.substring(lastSlashIndex, path.length());
		}
		else this.filename = path;
		//getting path name
	}
}
